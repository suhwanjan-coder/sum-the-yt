# sum-the-yt configuration. Copy to `.env` and adjust. CLI flags override these.

# Cookies for YouTube, to avoid rate limiting (HTTP 429) and bot checks.
# Either a browser name (chrome | safari | firefox | brave | edge, optionally
# chrome:ProfileName) or a path to a Netscape-format cookies.txt file.
# Use the file form if reading the browser's cookie DB fails -- on Windows it
# can raise a DPAPI decryption error outside the interactive desktop session.
SUMYT_COOKIES_FROM_BROWSER=chrome

# Full path to the claude CLI. Only needed if it is not on PATH -- e.g. the
# winget package ships no Links shortcut, though that location is auto-detected.
SUMYT_CLAUDE_BIN=

# Override the claude CLI model (leave blank to use the CLI default).
# e.g. claude-opus-4-8, claude-haiku-4-5
SUMYT_CLAUDE_MODEL=

# faster-whisper model size for the fallback path: tiny|base|small|medium|large-v3
SUMYT_WHISPER_MODEL=small

# Base directory for per-video artifact folders.
SUMYT_VIDEOS_DIR=videos

# Transcript char count above which map-reduce summarization is used.
SUMYT_MAX_CHARS=120000

# Set to 1/true to disable the Whisper fallback (fail if no subtitles).
SUMYT_NO_WHISPER=
